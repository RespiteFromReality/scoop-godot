{
    "version": "4.8-beta1",
    "description": "A feature-packed, cross-platform game engine to create 2D and 3D games from a unified interface.",
    "homepage": "https://godotengine.org/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/godotengine/godot-builds/releases/download/4.8-beta1/Godot_v4.8-beta1_mono_win64.zip",
            "hash": "sha512:f1a7933dccc4f4c8bc89fbd81feb556ecd810b699224a667d99f3ef73ffda1bddb94df880cdd7f1787a071a56b45b2ca1d8a471bde20493be24962fc7b781c39",
            "extract_dir": "Godot_v4.8-beta1_mono_win64"
        },
        "32bit": {
            "url": "https://github.com/godotengine/godot-builds/releases/download/4.8-beta1/Godot_v4.8-beta1_mono_win32.zip",
            "hash": "sha512:1f555933fbb7a2f73c63068a4bfad54186e562765dc0cc1895c7f2728b1e5418295063eeb63296003157641934e73b4d10509872ca98d8e35449051eb9d75feb",
            "extract_dir": "Godot_v4.8-beta1_mono_win32"
        }
    },
    "pre_install": [
        "Remove-Item \"$dir\\Godot_*_console.*\"",
        "Get-Item \"$dir\\Godot_*.exe\" | Rename-Item -NewName 'godot-mono.exe'"
    ],
    "bin": "godot-mono.exe",
    "shortcuts": [
        [
            "godot-mono.exe",
            "Godot Engine (Mono)"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/godotengine/godot-builds/releases",
        "jsonpath": "$[*].tag_name",
        "regex": "(?<ver>[\\d.]+)-beta(?<beta>[\\d.]+)",
        "replace": "${1}-beta${2}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/godotengine/godot-builds/releases/download/$version/Godot_v$version_mono_win64.zip",
                "extract_dir": "Godot_v$version_mono_win64"
            },
            "32bit": {
                "url": "https://github.com/godotengine/godot-builds/releases/download/$version/Godot_v$version_mono_win32.zip",
                "extract_dir": "Godot_v$version_mono_win32"
            }
        },
        "hash": {
            "url": "$baseurl/SHA512-SUMS.txt"
        }
    }
}
